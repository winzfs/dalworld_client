{
  "name": "dalworld_client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run data:generate && npm run tilesets:generate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run data:generate && npm run typecheck && npm run check:authority && npm run check:protocol && npm run check:data-sync && npm run build",
    "check:authority": "node scripts/check-client-authority-boundary.mjs",
    "check:protocol": "node scripts/check-protocol-sync.mjs",
    "check:data-sync": "node scripts/check-game-data-sync.mjs",
    "data:generate": "node scripts/generate-game-data.mjs",
    "deploy": "wrangler deploy",
    "tilesets:generate": "node scripts/generate-tileset-manifest.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
